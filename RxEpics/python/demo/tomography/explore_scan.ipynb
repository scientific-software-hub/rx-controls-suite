{
 "cells": [
  {
   "cell_type": "markdown",
   "id": "title",
   "metadata": {},
   "source": [
    "# Tomography Scan Explorer\\n",
    "\\n",
    "Load an HDF5 file produced by `tomography_scan.py` and explore: projection counts, beam position stability, beam current drift, and basic statistics."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "imports",
   "metadata": {},
   "outputs": [],
   "source": [
    "import h5py\\n",
    "import numpy as np\\n",
    "import matplotlib.pyplot as plt\\n",
    "from pathlib import Path\\n",
    "import glob, os"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "load",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Find and load the most recent scan HDF5\\n",
    "# Override: set h5_path = Path(\\"path/to/scan_....h5\\") before running this cell\\n",
    "\\n",
    "try:\\n",
    "    h5_path\\n",
    "except NameError:\\n",
    "    demo_dir = Path.cwd()\\n",
    "    files = sorted(glob.glob(str(demo_dir / \\"scan_*.h5\\")), key=os.path.getmtime, reverse=True)\\n",
    "    if not files:\\n",
    "        raise FileNotFoundError(\\n",
    "            f\\"No scan_*.h5 files found in {demo_dir}. \\"\\n",
    "            f\\"Run tomography_scan.py first, or set h5_path = Path('...').\\"\\n",
    "        )\\n",
    "    h5_path = Path(files[0])\\n",
    "\\n",
    "print(f\\"Loading: {h5_path}\\")\\n",
    "\\n",
    "f = h5py.File(h5_path, \\"r\\")\\n",
    "ds = f[\\"projections\\"]\\n",
    "data = ds[:]  # read all into memory\\n",
    "\\n",
    "# Metadata\\n",
    "print(\\"\\\\n=== Scan Metadata ===\\")\\n",
    "for key in sorted(f.attrs):\\n",
    "    print(f\\"  {key}: {f.attrs[key]}\\")\\n",
    "print(f\\"  frames: {ds.shape[0]}\\")\\n",
    "print(f\\"  fields: {ds.dtype.names}\\")\\n",
    "print(f\\"  angle: {data['angle'][0]:.2f} .. {data['angle'][-1]:.2f} deg\\")\\n",
    "print(f\\"  counts: {data['counts'].min():.0f} .. {data['counts'].max():.0f}\\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "proj_md",
   "metadata": {},
   "source": [
    "### Projections: counts vs angle\\n",
    "\\n",
    "Each point is one detector frame. Counts should be roughly constant (~3000 for 30ms exposure) with Poisson noise. A trend or step would indicate beam drift or a real feature in the sample."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "proj_plot",
   "metadata": {},
   "outputs": [],
   "source": [
    "fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(12, 6), sharex=True)\\n",
    "\\n",
    "ax1.plot(data[\\"angle\\"], data[\\"counts\\"], lw=0.5, color=\\"steelblue\\", alpha=0.8)\\n",
    "ax1.axhline(np.mean(data[\\"counts\\"]), color=\\"crimson\\", ls=\\"--\\", lw=1,\\n",
    "            label=f\\"mean = {np.mean(data['counts']):.0f}\\")\\n",
    "ax1.set_ylabel(\\"Counts\\", fontsize=11)\\n",
    "ax1.legend(fontsize=9)\\n",
    "ax1.grid(True, alpha=0.3)\\n",
    "\\n",
    "window = min(20, len(data))\\n",
    "smooth = np.convolve(data[\\"counts\\"], np.ones(window)/window, mode=\\"valid\\")\\n",
    "ax2.plot(data[\\"angle\\"][window-1:], smooth, lw=1.2, color=\\"darkgreen\\")\\n",
    "ax2.set_xlabel(\\"Angle (deg)\\", fontsize=11)\\n",
    "ax2.set_ylabel(f\\"Counts (rolling mean, n={window})\\", fontsize=11)\\n",
    "ax2.grid(True, alpha=0.3)\\n",
    "\\n",
    "fig.suptitle(\\"Detector Counts vs Projection Angle\\", fontsize=13, fontweight=\\"bold\\")\\n",
    "fig.tight_layout()\\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "beam_pos_md",
   "metadata": {},
   "source": [
    "### Beam position stability\\n",
    "\\n",
    "Scatter plot of beam centroid X vs Y over the scan. A tight cluster means stable beam; drift or outliers would flag a problem."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "beam_pos_plot",
   "metadata": {},
   "outputs": [],
   "source": [
    "fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(12, 5))\\n",
    "\\n",
    "sc = ax1.scatter(data[\\"beam_posx\\"], data[\\"beam_posy\\"], c=data[\\"angle\\"],\\n",
    "                 cmap=\\"viridis\\", s=8, alpha=0.7)\\n",
    "ax1.axhline(0, color=\\"gray\\", ls=\\"--\\", lw=0.5)\\n",
    "ax1.axvline(0, color=\\"gray\\", ls=\\"--\\", lw=0.5)\\n",
    "ax1.set_xlabel(\\"Beam Position X (mm)\\", fontsize=11)\\n",
    "ax1.set_ylabel(\\"Beam Position Y (mm)\\", fontsize=11)\\n",
    "ax1.set_title(\\"Beam Centroid (color = angle)\\", fontsize=11)\\n",
    "ax1.set_aspect(\\"equal\\")\\n",
    "plt.colorbar(sc, ax=ax1, label=\\"Angle (deg)\\")\\n",
    "\\n",
    "ax2.plot(data[\\"angle\\"], data[\\"beam_posx\\"] * 1000, lw=0.5, label=\\"X\\", alpha=0.8)\\n",
    "ax2.plot(data[\\"angle\\"], data[\\"beam_posy\\"] * 1000, lw=0.5, label=\\"Y\\", alpha=0.8)\\n",
    "ax2.set_xlabel(\\"Angle (deg)\\", fontsize=11)\\n",
    "ax2.set_ylabel(\\"Position (\\\\u03bcm)\\", fontsize=11)\\n",
    "ax2.set_title(\\"Beam Position vs Angle\\", fontsize=11)\\n",
    "ax2.legend(fontsize=9)\\n",
    "ax2.grid(True, alpha=0.3)\\n",
    "\\n",
    "fig.suptitle(\\"Beam Position Stability\\", fontsize=13, fontweight=\\"bold\\")\\n",
    "fig.tight_layout()\\n",
    "plt.show()\\n",
    "\\n",
    "print(f\\"Beam X: mean={data['beam_posx'].mean()*1000:+.3f} \\\\u03bcm, std={data['beam_posx'].std()*1000:.3f} \\\\u03bcm\\")\\n",
    "print(f\\"Beam Y: mean={data['beam_posy'].mean()*1000:+.3f} \\\\u03bcm, std={data['beam_posy'].std()*1000:.3f} \\\\u03bcm\\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "beam_cur_md",
   "metadata": {},
   "source": [
    "### Beam current and normalised count rate"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "beam_cur_plot",
   "metadata": {},
   "outputs": [],
   "source": [
    "fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(12, 6), sharex=True)\\n",
    "\\n",
    "ax1.plot(data[\\"angle\\"], data[\\"beam_current\\"], lw=0.5, color=\\"darkorange\\", alpha=0.8)\\n",
    "ax1.axhline(np.mean(data[\\"beam_current\\"]), color=\\"navy\\", ls=\\"--\\", lw=1,\\n",
    "            label=f\\"mean = {np.mean(data['beam_current']):.2f} mA\\")\\n",
    "ax1.set_ylabel(\\"Beam Current (mA)\\", fontsize=11)\\n",
    "ax1.legend(fontsize=9)\\n",
    "ax1.grid(True, alpha=0.3)\\n",
    "\\n",
    "normalized = data[\\"counts\\"] / data[\\"beam_current\\"]\\n",
    "ax2.plot(data[\\"angle\\"], normalized, lw=0.5, color=\\"teal\\", alpha=0.8)\\n",
    "ax2.axhline(np.mean(normalized), color=\\"crimson\\", ls=\\"--\\", lw=1,\\n",
    "            label=f\\"mean = {np.mean(normalized):.1f} cts/mA\\")\\n",
    "ax2.set_xlabel(\\"Angle (deg)\\", fontsize=11)\\n",
    "ax2.set_ylabel(\\"Counts / Beam Current\\", fontsize=11)\\n",
    "ax2.legend(fontsize=9)\\n",
    "ax2.grid(True, alpha=0.3)\\n",
    "\\n",
    "fig.suptitle(\\"Beam Current Stability\\", fontsize=13, fontweight=\\"bold\\")\\n",
    "fig.tight_layout()\\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "summary_md",
   "metadata": {},
   "source": [
    "### Summary statistics"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "summary_stats",
   "metadata": {},
   "outputs": [],
   "source": [
    "print(\\"=== Tomography Scan Summary ===\\")\\n",
    "print(f\\"File: {h5_path}\\\\n\\")\\n",
    "\\n",
    "elapsed = data[\\"timestamp\\"][-1] - data[\\"timestamp\\"][0]\\n",
    "fps = len(data) / elapsed if elapsed > 0 else float(\\"inf\\")\\n",
    "cts_per_ma = data[\\"counts\\"].mean() / data[\\"beam_current\\"].mean()\\n",
    "\\n",
    "print(f\\"  Frames:          {len(data)}\\")\\n",
    "print(f\\"  Elapsed:         {elapsed:.1f} s\\")\\n",
    "print(f\\"  Frame rate:      {fps:.1f} fps\\")\\n",
    "print(f\\"  Angle range:     {data['angle'][0]:.2f} to {data['angle'][-1]:.2f} deg\\")\\n",
    "print()\\n",
    "print(f\\"  Counts:          mean={data['counts'].mean():.0f}  std={data['counts'].std():.0f}\\")\\n",
    "print(f\\"  Beam current:    mean={data['beam_current'].mean():.2f}  std={data['beam_current'].std():.3f} mA\\")\\n",
    "print(f\\"  Counts / mA:     {cts_per_ma:.1f}\\")\\n",
    "print()\\n",
    "print(f\\"  Beam pos X:      mean={data['beam_posx'].mean()*1000:+.3f}  std={data['beam_posx'].std()*1000:.3f} \\\\u03bcm\\")\\n",
    "print(f\\"  Beam pos Y:      mean={data['beam_posy'].mean()*1000:+.3f}  std={data['beam_posy'].std()*1000:.3f} \\\\u03bcm\\")\\n",
    "print(f\\"  Beam drift:      {np.sqrt(data['beam_posx'].std()**2 + data['beam_posy'].std()**2)*1e6:.1f} \\\\u03bcm RMS\\")\\n",
    "\\n",
    "f.close()"
   ]
  }
 ],
